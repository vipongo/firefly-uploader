# Copy to .env (gitignored) and fill in. Never commit it.

# The web app's data: users, Firefly connections, remembered merchants (default: uploader.db here)
# UPLOADER_DB=uploader.db
# Encrypts the Firefly tokens in the database. Without it, a key file "secret.key" is made next
# to the database on first start. Make one with:
#   python -c "from firefly_uploader.auth import TokenCipher; print(TokenCipher.new_key())"
# UPLOADER_SECRET_KEY=

# Only for `python -m firefly_uploader check`; the web app keeps its connections itself.
# Token: Firefly -> Options -> Profile -> OAuth -> Personal Access Tokens -> Create new token
FIREFLY_URL=https://firefly.example.com
FIREFLY_TOKEN=

# Throwaway test instance, filled in by dev/firefly-test/setup.py
FIREFLY_TEST_URL=
FIREFLY_TEST_TOKEN=
